# ===========================================
# CONFIGURACIÓN - Sistema Académico API
# ===========================================
# Copia este archivo a .env y completa los valores

# ============ EMAIL ============
MAIL_USERNAME=tuemail@unach.mx
MAIL_PASSWORD=tu-app-password

# ============ JWT ============
JWT_SECRET=tu-secret-key-muy-largo-y-seguro-al-menos-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ============ POSTGRESQL (Aiven) ============
URL_DATABASE_POSTGRESQL=jdbc:postgresql://tu-host.aivencloud.com:puerto/academic_system?ssl=require&user=tu-user&password=tu-password
USERNAME_POSTGRESQL=avnadmin
PASSWORD_POSTGRESQL=tu-password

# ============ REDIS ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
